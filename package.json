{
  "name": "sultanc-playground",
  "version": "0.1.0",
  "private": true,
  "description": "SultanC in the browser: write, check and run Arabic or English SultanC code.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch-compiler": "node scripts/fetch-compiler.mjs",
    "assets:local": "bash scripts/build-assets.sh",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node scripts/test-browser.mjs",
    "test:surface": "node scripts/test-surface.mjs",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@codemirror/lint": "6.9.7"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
