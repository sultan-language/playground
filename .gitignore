# Dependencies
node_modules/

# npm build output (npm run build / npm start / tests). Always safe to delete;
# `npm run clean` removes it.
build/

# Compiler assets, made by `npm run fetch-compiler` from the SultanC repository
# (or `npm run assets:local` from a local checkout). Only source.json is committed.
compiler/assets/
compiler/cache/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
