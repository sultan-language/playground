# Dependencies
node_modules/

# npm build output (npm run build / npm start / tests). Always safe to delete;
# `npm run clean` removes it.
build/

# Compiler assets: generated by `npm run fetch-compiler` (release download) or
# `npm run assets:local` (local SultanC checkout). Only release.json is committed.
compiler/assets/
compiler/cache/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
